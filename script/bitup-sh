#!/bin/sh
# bitup - The Bitbucket CLI installer (rustup style)
# https://github.com/gopu-inc/bit
#
# Usage: curl -fsSL https://raw.githubusercontent.com/gopu-inc/bit/main/script/bitup-sh | sh
#        curl -fsSL https://raw.githubusercontent.com/gopu-inc/bit/main/script/bitup-sh | sh -s -- --help

set -eu

# =============================================================================
#                        BITUP PROFESSIONAL INSTALLER
# =============================================================================
# Version: 1.0.0
# Author: gopu-inc
# License: MIT
#
# Features:
#   - Zero dependencies (pure POSIX shell)
#   - Automatic architecture detection
#   - Cross-platform support (Linux/macOS/Windows)
#   - Progressive download with progress bar
#   - Toolchain management
#   - Self-update capability
# =============================================================================

# Configuration
BITUP_VERSION="1.0.0"
BITUP_CHANNEL="stable"  # stable, beta, nightly
GITHUB_REPO="gopu-inc/bit"
GITHUB_BRANCH="main"
RAW_BASE="https://raw.githubusercontent.com/${GITHUB_REPO}/${GITHUB_BRANCH}"
API_BASE="https://api.github.com/repos/${GITHUB_REPO}"
RELEASE_BASE="https://github.com/${GITHUB_REPO}/releases/download"
INSTALL_ROOT="${HOME}/.bitup"

# Colors (if terminal supports)
if [ -t 1 ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    MAGENTA='\033[0;35m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    DIM='\033[2m'
    NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; MAGENTA=''; CYAN=''; BOLD=''; DIM=''; NC=''
fi

# =============================================================================
#                            UTILITY FUNCTIONS
# =============================================================================

log_info() {
    printf "${GREEN}info:${NC} %s\n" "$*"
}

log_warn() {
    printf "${YELLOW}warning:${NC} %s\n" "$*" >&2
}

log_error() {
    printf "${RED}error:${NC} %s\n" "$*" >&2
}

log_step() {
    printf "${BLUE}==>${NC} ${BOLD}%s${NC}\n" "$*"
}

log_success() {
    printf "${GREEN}✅ %s${NC}\n" "$*"
}

log_debug() {
    if [ "${BITUP_DEBUG:-0}" = "1" ]; then
        printf "${DIM}[DEBUG] %s${NC}\n" "$*"
    fi
}

die() {
    log_error "$*"
    exit 1
}

# Detect OS and architecture
detect_platform() {
    PLATFORM="$(uname -s | tr '[:upper:]' '[:lower:]')"
    ARCH="$(uname -m)"
    
    case "${PLATFORM}" in
        linux)      PLATFORM="linux" ;;
        darwin)     PLATFORM="darwin" ;;
        mingw*|cygwin*|msys*)
                    PLATFORM="windows" ;;
        freebsd)    PLATFORM="freebsd" ;;
        openbsd)    PLATFORM="openbsd" ;;
        netbsd)     PLATFORM="netbsd" ;;
        *)          die "Unsupported platform: ${PLATFORM}" ;;
    esac
    
    case "${ARCH}" in
        x86_64|amd64)   ARCH="x86_64" ;;
        aarch64|arm64)  ARCH="aarch64" ;;
        i*86)           ARCH="i686" ;;
        armv7l)         ARCH="armv7" ;;
        ppc64le)        ARCH="powerpc64le" ;;
        s390x)          ARCH="s390x" ;;
        *)              die "Unsupported architecture: ${ARCH}" ;;
    esac
    
    # Special case for Apple Silicon
    if [ "${PLATFORM}" = "darwin" ] && [ "${ARCH}" = "aarch64" ]; then
        ARCH="arm64"
    fi
    
    TARGET="${ARCH}-${PLATFORM}"
    log_debug "Detected platform: ${TARGET}"
}

# Check if command exists
has_command() {
    command -v "$1" >/dev/null 2>&1
}

# Download with progress
download() {
    url="$1"
    output="$2"
    
    if has_command curl; then
        if [ -t 1 ]; then
            curl -fSL --progress-bar "$url" -o "$output"
        else
            curl -fSL "$url" -o "$output"
        fi
    elif has_command wget; then
        if [ -t 1 ]; then
            wget -q --show-progress "$url" -O "$output"
        else
            wget -q "$url" -O "$output"
        fi
    else
        die "Neither curl nor wget found. Please install one of them."
    fi
}

# Download from GitHub RAW
download_raw() {
    path="$1"
    output="$2"
    download "${RAW_BASE}/${path}" "$output"
}

# Get latest release version from GitHub API
get_latest_version() {
    channel="${1:-stable}"
    
    case "$channel" in
        stable)
            if has_command curl; then
                curl -s "${API_BASE}/releases/latest" | grep '"tag_name":' | cut -d'"' -f4
            elif has_command wget; then
                wget -q -O- "${API_BASE}/releases/latest" | grep '"tag_name":' | cut -d'"' -f4
            else
                echo "v1.0.0"  # Fallback
            fi
            ;;
        beta|nightly)
            echo "nightly"  # Pour l'instant, même chose
            ;;
        *)
            echo "$channel"
            ;;
    esac
}

# Verify checksum
verify_checksum() {
    file="$1"
    expected="$2"
    
    if [ -z "$expected" ] || [ "$expected" = "skip" ]; then
        return 0
    fi
    
    if has_command sha256sum; then
        actual=$(sha256sum "$file" | cut -d' ' -f1)
    elif has_command shasum; then
        actual=$(shasum -a 256 "$file" | cut -d' ' -f1)
    else
        log_warn "No checksum tool found, skipping verification"
        return 0
    fi
    
    if [ "$actual" != "$expected" ]; then
        log_error "Checksum mismatch"
        log_debug "Expected: $expected"
        log_debug "Actual:   $actual"
        return 1
    fi
    return 0
}

# Prompt user
prompt() {
    question="$1"
    default="${2:-}"
    
    if [ -n "$default" ]; then
        printf "%s [%s] " "$question" "$default"
    else
        printf "%s " "$question"
    fi
    
    read -r answer
    if [ -z "$answer" ] && [ -n "$default" ]; then
        answer="$default"
    fi
    printf "%s" "$answer"
}

# =============================================================================
#                        TOOLCHAIN MANAGEMENT
# =============================================================================

# Install toolchain
install_toolchain() {
    version="${1:-${BITUP_CHANNEL}}"
    
    log_step "Installing bit ${version} for ${TARGET}"
    
    # Resolve version if channel
    if [ "$version" = "stable" ] || [ "$version" = "beta" ] || [ "$version" = "nightly" ]; then
        version=$(get_latest_version "$version")
        log_info "Latest ${version} version: ${version}"
    fi
    
    # Create directories
    mkdir -p "${INSTALL_ROOT}/toolchains/${version}"
    mkdir -p "${INSTALL_ROOT}/bin"
    mkdir -p "${INSTALL_ROOT}/tmp"
    
    # Try to download pre-built binary
    binary_name="bit-${TARGET}"
    if [ "$TARGET" = "x86_64-windows" ]; then
        binary_name="bit-win64.exe"
    elif [ "$TARGET" = "i686-windows" ]; then
        binary_name="bit-win32.exe"
    fi
    
    # GitHub release URL
    binary_url="${RELEASE_BASE}/${version}/${binary_name}"
    binary_file="${INSTALL_ROOT}/toolchains/${version}/bit"
    
    # Add .exe for Windows
    if [ "$PLATFORM" = "windows" ]; then
        binary_file="${binary_file}.exe"
    fi
    
    log_info "Downloading bit from GitHub releases..."
    if download "$binary_url" "$binary_file" 2>/dev/null; then
        chmod +x "$binary_file"
        
        # Try to download checksum
        checksum_url="${RELEASE_BASE}/${version}/bit-${TARGET}.sha256"
        checksum_file="${INSTALL_ROOT}/tmp/checksum"
        if download "$checksum_url" "$checksum_file" 2>/dev/null; then
            expected=$(cat "$checksum_file" | cut -d' ' -f1)
            log_info "Verifying checksum..."
            if verify_checksum "$binary_file" "$expected"; then
                log_success "Checksum verified"
            else
                log_warn "Checksum verification failed, but continuing..."
            fi
        fi
        
        log_success "Binary downloaded successfully!"
    else
        log_warn "No pre-built binary available for ${TARGET}"
        return 1
    fi
    
    # Create symlink
    ln -sf "$binary_file" "${INSTALL_ROOT}/bin/bit"
    if [ "$PLATFORM" = "windows" ]; then
        ln -sf "$binary_file" "${INSTALL_ROOT}/bin/bit.exe"
    fi
    
    # Save active version
    echo "$version" > "${INSTALL_ROOT}/VERSION"
    
    log_success "bit ${version} installed successfully!"
}

# Install from source (fallback)
install_from_source() {
    log_step "Building from source..."
    
    # Check build dependencies
    MISSING_DEPS=""
    for cmd in gcc make git; do
        if ! has_command "$cmd"; then
            MISSING_DEPS="${MISSING_DEPS} $cmd"
        fi
    done
    
    # Check for curl dev libraries
    if [ "$PLATFORM" = "linux" ] && ! has_command curl-config; then
        MISSING_DEPS="${MISSING_DEPS} libcurl-dev"
    fi
    
    if [ -n "$MISSING_DEPS" ]; then
        log_error "Missing build dependencies:${MISSING_DEPS}"
        log_info "Please install them using your package manager:"
        case "$PLATFORM" in
            linux)
                if has_command apt-get; then
                    echo "  sudo apt-get install build-essential libcurl4-openssl-dev git"
                elif has_command yum; then
                    echo "  sudo yum install gcc make libcurl-devel git"
                elif has_command apk; then
                    echo "  sudo apk add gcc make musl-dev curl-dev git"
                fi
                ;;
            darwin)
                echo "  brew install gcc make curl git"
                ;;
        esac
        die "Build failed"
    fi
    
    # Create temp directory
    build_dir="${INSTALL_ROOT}/tmp/build"
    rm -rf "$build_dir"
    mkdir -p "$build_dir"
    
    # Download source
    log_info "Cloning repository..."
    git clone --depth=1 "https://github.com/${GITHUB_REPO}.git" "$build_dir"
    
    # Build
    cd "$build_dir"
    log_info "Compiling (this may take a moment)..."
    if [ "$PLATFORM" = "windows" ]; then
        # Cross-compilation from Linux/macOS to Windows
        if has_command x86_64-w64-mingw32-gcc; then
            make windows
        elif has_command i686-w64-mingw32-gcc; then
            make windows-32
        else
            die "No Windows cross-compiler found"
        fi
    else
        make release
    fi
    
    # Install
    mkdir -p "${INSTALL_ROOT}/toolchains/local"
    if [ -f "bin/bit" ]; then
        cp "bin/bit" "${INSTALL_ROOT}/toolchains/local/"
    elif [ -f "bin/bit.exe" ]; then
        cp "bin/bit.exe" "${INSTALL_ROOT}/toolchains/local/"
    fi
    
    ln -sf "../toolchains/local/bit" "${INSTALL_ROOT}/bin/bit"
    
    log_success "Built from source successfully!"
}

# Update bitup itself
self_update() {
    log_step "Updating bitup..."
    
    # Download latest bitup
    tmp_script="${INSTALL_ROOT}/tmp/bitup.new"
    download_raw "script/bitup-sh" "$tmp_script"
    
    # Verify
    if [ ! -s "$tmp_script" ]; then
        die "Download failed"
    fi
    
    # Replace current script
    if [ -n "${BASH_SOURCE:-}" ]; then
        script_path="${BASH_SOURCE}"
    else
        script_path="$0"
    fi
    
    # If running from pipe, we can't update
    if [ "$script_path" = "sh" ] || [ "$script_path" = "bash" ]; then
        log_warn "Cannot update when run from pipe"
        log_info "New version saved to: $tmp_script"
        log_info "Run: cat $tmp_script > ~/.local/bin/bitup && chmod +x ~/.local/bin/bitup"
        return
    fi
    
    if [ -w "$script_path" ]; then
        cat "$tmp_script" > "$script_path"
        chmod +x "$script_path"
        log_success "bitup updated to latest version"
    else
        log_warn "Cannot update script (permission denied)"
        log_info "New version saved to: $tmp_script"
    fi
}

# List installed toolchains
list_toolchains() {
    log_step "Installed toolchains"
    
    active=$(cat "${INSTALL_ROOT}/VERSION" 2>/dev/null || echo "none")
    
    if [ ! -d "${INSTALL_ROOT}/toolchains" ]; then
        echo "  No toolchains installed"
        return
    fi
    
    for tc in "${INSTALL_ROOT}"/toolchains/*; do
        if [ -d "$tc" ]; then
            name=$(basename "$tc")
            if [ "$name" = "$active" ]; then
                printf "  ${GREEN}%s (active)${NC}\n" "$name"
            else
                printf "  %s\n" "$name"
            fi
        fi
    done
}

# Generate shell completions
generate_completions() {
    log_step "Generating shell completions"
    
    completions_dir="${INSTALL_ROOT}/completions"
    mkdir -p "$completions_dir"
    
    if [ ! -f "${INSTALL_ROOT}/bin/bit" ]; then
        die "bit not installed"
    fi
    
    # Basic completions for bash
    cat > "${completions_dir}/bit.bash" << 'EOF'
_bit_completions() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    
    opts="login whoami copy add commit sends pull switch create-branch merge-create merge-now tag mall ci restore sha --help --verbose"
    
    if [[ ${cur} == -* ]] ; then
        COMPREPLY=( $(compgen -W "--help --verbose" -- ${cur}) )
    else
        COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )
    fi
    return 0
}
complete -F _bit_completions bit
EOF
    
    # Zsh completions
    cat > "${completions_dir}/bit.zsh" << 'EOF'
#compdef bit
_arguments \
    '--help[Show help]' \
    '--verbose[Verbose output]' \
    '1:command:(login whoami copy add commit sends pull switch create-branch merge-create merge-now tag mall ci restore sha)' \
    '*::arg:->args'
EOF
    
    log_success "Completions generated in ${completions_dir}"
    log_info "To enable, add to your shell config:"
    echo "  Bash: source ${completions_dir}/bit.bash"
    echo "  Zsh:  source ${completions_dir}/bit.zsh"
}

# =============================================================================
#                            MAIN INSTALLATION
# =============================================================================

# Show help
show_help() {
    cat << EOF
${BOLD}bitup${NC} ${DIM}${BITUP_VERSION}${NC}
The Bitbucket CLI installer

${BOLD}USAGE:${NC}
    curl -fsSL https://raw.githubusercontent.com/${GITHUB_REPO}/main/script/bitup-sh | sh [--] [FLAGS] [OPTIONS]

${BOLD}FLAGS:${NC}
    -h, --help       Prints help information
    -v, --verbose    Prints verbose output
    -y, --yes        Skip confirmation prompts
    -f, --force      Force installation (overwrite existing)
    
${BOLD}OPTIONS:${NC}
    --channel <CHANNEL>    Channel to install [stable, beta, nightly] (default: stable)
    --target <TRIPLE>      Target triple to install for (auto-detected)
    --version <VERSION>    Specific version to install
    --to <DIR>             Install to specific directory (default: ~/.bitup)
    
${BOLD}COMMANDS:${NC}
    install         Install bit (default)
    update          Update bit and bitup
    list            List installed toolchains
    default         Set default toolchain
    completions     Generate shell completions
    self-update     Update bitup itself

${BOLD}EXAMPLES:${NC}
    curl -fsSL https://raw.githubusercontent.com/${GITHUB_REPO}/main/script/bitup-sh | sh
    curl -fsSL https://raw.githubusercontent.com/${GITHUB_REPO}/main/script/bitup-sh | sh -s -- --channel beta
    curl -fsSL https://raw.githubusercontent.com/${GITHUB_REPO}/main/script/bitup-sh | sh -s -- --target x86_64-linux
    curl -fsSL https://raw.githubusercontent.com/${GITHUB_REPO}/main/script/bitup-sh | sh -s -- --to ~/my-custom-path

${BOLD}MORE:${NC}
    https://github.com/${GITHUB_REPO}
EOF
}

# Parse arguments
parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                BITUP_DEBUG=1
                ;;
            -y|--yes)
                ASSUME_YES=1
                ;;
            -f|--force)
                FORCE=1
                ;;
            --channel)
                BITUP_CHANNEL="$2"
                shift
                ;;
            --target)
                TARGET="$2"
                shift
                ;;
            --version)
                SPECIFIC_VERSION="$2"
                shift
                ;;
            --to)
                INSTALL_ROOT="$2"
                shift
                ;;
            install)
                COMMAND="install"
                ;;
            update)
                COMMAND="update"
                ;;
            list)
                COMMAND="list"
                ;;
            default)
                COMMAND="default"
                DEFAULT_VERSION="$2"
                shift
                ;;
            completions)
                COMMAND="completions"
                ;;
            self-update)
                COMMAND="self-update"
                ;;
            --)
                shift
                ;;
            *)
                if [ -z "${COMMAND:-}" ]; then
                    COMMAND="$1"
                else
                    log_error "Unknown option: $1"
                    show_help
                    exit 1
                fi
                ;;
        esac
        shift
    done
}

# Main installation flow
main() {
    # Show banner
    cat << "EOF"
[35m
    ╔═══════════════════════════════════════╗
    ║  [1mbitup - The Bitbucket CLI[0m[35m          ║
    ║  [2mhttps://github.com/gopu-inc/bit[0m[35m      ║
    ╚═══════════════════════════════════════╝
[0m
EOF
    
    # Detect platform unless specified
    if [ -z "${TARGET:-}" ]; then
        detect_platform
    fi
    
    # Handle commands
    case "${COMMAND:-install}" in
        install)
            log_info "Installing bit for ${TARGET}"
            
            # Check if already installed
            if [ -f "${INSTALL_ROOT}/bin/bit" ] && [ -z "${FORCE:-}" ]; then
                if [ "${ASSUME_YES:-}" != "1" ]; then
                    printf "bit already installed. Overwrite? [y/N] "
                    read -r answer
                    case "$answer" in
                        y|Y|yes|YES) ;;
                        *) die "Installation aborted" ;;
                    esac
                fi
            fi
            
            # Use specific version if provided
            version="${SPECIFIC_VERSION:-${BITUP_CHANNEL}}"
            
            # Try binary install first
            if ! install_toolchain "$version" 2>/dev/null; then
                log_warn "Binary download failed, falling back to source build"
                install_from_source
            fi
            
            # Create shell config helper
            mkdir -p "${INSTALL_ROOT}/env"
            cat > "${INSTALL_ROOT}/env/bitup.env" << EOF
# bitup environment
export PATH="\$PATH:${INSTALL_ROOT}/bin"
EOF
            
            # Setup PATH
            cat << EOF

${BOLD}Configure your shell:${NC}
  Add to ~/.profile, ~/.bashrc, or ~/.zshrc:
  
  ${CYAN}export PATH="\$PATH:${INSTALL_ROOT}/bin"${NC}

  Or source the prepared file:
  ${CYAN}source ${INSTALL_ROOT}/env/bitup.env${NC}

  Or run directly:
  ${CYAN}${INSTALL_ROOT}/bin/bit${NC}

${BOLD}Get started:${NC}
  ${CYAN}bit login${NC}        # Authenticate with Bitbucket
  ${CYAN}bit copy <url>${NC}   # Clone a repository
  ${CYAN}bit --help${NC}       # Show all commands

${BOLD}Toolchain management:${NC}
  ${CYAN}bitup list${NC}        # List installed versions
  ${CYAN}bitup update${NC}      # Update bit and bitup
  ${CYAN}bitup completions${NC} # Generate shell completions
EOF
            ;;
            
        update)
            log_step "Updating bit"
            
            # Update bitup first
            self_update
            
            # Update toolchain
            current_version=$(cat "${INSTALL_ROOT}/VERSION" 2>/dev/null || echo "stable")
            log_info "Updating toolchain from ${current_version}"
            
            # Remove old and install new
            rm -rf "${INSTALL_ROOT}/toolchains/${current_version}"
            install_toolchain "$current_version"
            ;;
            
        list)
            list_toolchains
            ;;
            
        default)
            if [ -n "${DEFAULT_VERSION:-}" ]; then
                if [ -d "${INSTALL_ROOT}/toolchains/${DEFAULT_VERSION}" ]; then
                    ln -sf "../toolchains/${DEFAULT_VERSION}/bit" "${INSTALL_ROOT}/bin/bit"
                    echo "$DEFAULT_VERSION" > "${INSTALL_ROOT}/VERSION"
                    log_success "Default toolchain set to ${DEFAULT_VERSION}"
                else
                    die "Toolchain ${DEFAULT_VERSION} not installed"
                fi
            else
                list_toolchains
                echo ""
                echo "Usage: bitup default <version>"
            fi
            ;;
            
        completions)
            generate_completions
            ;;
            
        self-update)
            self_update
            ;;
    esac
}

# Parse arguments and run
parse_args "$@"
main