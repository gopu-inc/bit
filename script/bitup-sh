#!/bin/sh
# bitup - The Bitbucket CLI installer for gopu.inc
# Supports: x86_64, aarch64, i686 (x86)
# Features: Progress bar, Auto-detection, Multi-arch

set -eu

# =============================================================================
#                        CONFIGURATION
# =============================================================================
GITHUB_REPO="gopu-inc/bit"
# Cible directe de ton tag de release
RELEASE_BASE="https://github.com/${GITHUB_REPO}/releases/download/latest"
INSTALL_DIR="/usr/local/bin"

# Couleurs pour le terminal
G='\033[0;32m'
B='\033[1;34m'
R='\033[0;31m'
NC='\033[0m'
BOLD='\033[1m'

log_step() { printf "${B}==>${NC} ${BOLD}%s${NC}\n" "$*"; }
log_error() { printf "${R}error:${NC} %s\n" "$*" >&2; exit 1; }
log_success() { printf "${G}✅ %s${NC}\n" "$*"; }

# =============================================================================
#                            DETECTION
# =============================================================================
ARCH=$(uname -m)
case "${ARCH}" in
    x86_64|amd64)   ASSET_NAME="bit-linux_x64-v1.0.2.1.tar.gz" ;;
    aarch64|arm64)  ASSET_NAME="bit-1.0.2-aarch64.tar.gz" ;;
    i386|i686)      ASSET_NAME="bit-linux_x86-v1.0.2.1.tar.gz" ;;
    *) log_error "Architecture ${ARCH} non supportée." ;;
esac

# =============================================================================
#                            MAIN PROCESS
# =============================================================================
main() {
    # Bannière gopu.inc
    echo "${B}---------------------------------------${NC}"
    echo "${BOLD}  bitup - gopu.inc CLI Installer${NC}"
    echo "${B}---------------------------------------${NC}"

    log_step "Detected ${ARCH}. Preparing to download ${ASSET_NAME}..."
    
    DOWNLOAD_URL="${RELEASE_BASE}/${ASSET_NAME}"
    TMP_DIR=$(mktemp -d)
    cd "$TMP_DIR"

    # 1. Téléchargement avec jauge de progression (#)
    # L'option -# (ou --progress-bar) est ce que tu as demandé
    if ! curl -fL -# "$DOWNLOAD_URL" -o "package.tar.gz"; then
        log_error "Impossible de télécharger depuis ${DOWNLOAD_URL}. Vérifiez votre connexion."
    fi

    # 2. Extraction
    log_step "Extracting files..."
    tar -xzf "package.tar.gz"
    
    # Trouver le binaire (évite les erreurs de nommage interne)
    BIT_BIN=$(find . -type f -executable ! -name "*.tar.gz" | head -1)
    
    if [ -z "$BIT_BIN" ]; then 
        log_error "Binaire introuvable dans l'archive téléchargée."
    fi
    
    chmod +x "$BIT_BIN"

    # 3. Installation
    log_step "Installing to ${INSTALL_DIR}/bit..."
    if [ -w "$INSTALL_DIR" ]; then
        mv "$BIT_BIN" "${INSTALL_DIR}/bit"
    else
        # Utilise sudo si les permissions manquent
        sudo mv "$BIT_BIN" "${INSTALL_DIR}/bit"
    fi

    # Nettoyage
    cd /
    rm -rf "$TMP_DIR"
    
    echo ""
    log_success "bit est installé avec succès pour l'architecture ${ARCH} !"
    echo "Essayez : ${BOLD}bit --help${NC} pour commencer."
}

# Exécution du script
main "$@"
