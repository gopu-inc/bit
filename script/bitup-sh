#!/bin/sh
# bitup - The Bitbucket CLI installer (direct install to /usr/local/bin)
# https://github.com/gopu-inc/bit
#
# Usage: curl -fsSL https://raw.githubusercontent.com/gopu-inc/bit/main/script/bitup-sh | sudo sh

set -eu

# =============================================================================
#                        BITUP INSTALLER
# =============================================================================
# Version: 1.0.0
# Author: gopu-inc
# License: MIT
# =============================================================================

# Configuration
GITHUB_REPO="gopu-inc/bit"
RELEASE_TAG="downloads"
RELEASE_BASE="https://github.com/${GITHUB_REPO}/releases/download/${RELEASE_TAG}"
INSTALL_DIR="/usr/local/bin"

# Colors (si supporté)
if [ -t 1 ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; NC=''
fi

# =============================================================================
#                            UTILITIES
# =============================================================================

log_info() { printf "${GREEN}info:${NC} %s\n" "$*"; }
log_warn() { printf "${YELLOW}warning:${NC} %s\n" "$*" >&2; }
log_error() { printf "${RED}error:${NC} %s\n" "$*" >&2; }
log_step() { printf "${BLUE}==>${NC} ${BOLD}%s${NC}\n" "$*"; }
log_success() { printf "${GREEN}✅ %s${NC}\n" "$*"; }
die() { log_error "$*"; exit 1; }

has_command() {
    command -v "$1" >/dev/null 2>&1
}

detect_platform() {
    PLATFORM="$(uname -s | tr '[:upper:]' '[:lower:]')"
    ARCH="$(uname -m)"
    
    case "${PLATFORM}" in
        linux)      PLATFORM="linux" ;;
        darwin)     PLATFORM="darwin" ;;
        mingw*|cygwin*|msys*) PLATFORM="windows" ;;
        *)          die "Unsupported platform: ${PLATFORM}" ;;
    esac
    
    case "${ARCH}" in
        x86_64|amd64)   ARCH="x86_64" ;;
        aarch64|arm64)  ARCH="aarch64" ;;
        i*86)           ARCH="x86" ;;
        *)              die "Unsupported architecture: ${ARCH}" ;;
    esac
    
    # Apple Silicon
    if [ "${PLATFORM}" = "darwin" ] && [ "${ARCH}" = "aarch64" ]; then
        ARCH="arm64"
    fi
    
    log_info "Detected: ${PLATFORM}-${ARCH}"
}

download() {
    url="$1"
    output="$2"
    
    if has_command curl; then
        curl -fL --progress-bar "$url" -o "$output"
    elif has_command wget; then
        wget -q --show-progress "$url" -O "$output"
    else
        die "Need curl or wget"
    fi
}

# =============================================================================
#                            INSTALLATION
# =============================================================================

get_binary_name() {
    case "${PLATFORM}-${ARCH}" in
        linux-x86_64)   echo "bit-linux-x86_64" ;;
        linux-x86)      echo "bit-linux_x86-v1.0.2.1.tar.gz" ;;
        linux-aarch64)  echo "bit-1.0.2-aarch64.tar.gz" ;;
        darwin-arm64)   echo "bit-darwin-arm64" ;;
        darwin-x86_64)  echo "bit-darwin-x86_64" ;;
        windows-x86_64) echo "bit-windows-x86_64.exe" ;;
        windows-x86)    echo "bit-windows-x86.exe" ;;
        *) die "No binary for ${PLATFORM}-${ARCH}" ;;
    esac
}

install_binary() {
    BINARY_NAME=$(get_binary_name)
    BINARY_URL="${RELEASE_BASE}/${BINARY_NAME}"
    
    log_step "Downloading ${BINARY_NAME}"
    
    # Télécharger dans /tmp
    TMP_DIR="/tmp/bitup.$$"
    mkdir -p "$TMP_DIR"
    cd "$TMP_DIR"
    
    download "$BINARY_URL" "$BINARY_NAME"
    
    # Extraire si nécessaire
    case "$BINARY_NAME" in
        *.tar.gz)
            log_info "Extracting archive..."
            tar -xzf "$BINARY_NAME"
            # Chercher le binaire
            BIT_BIN=$(find . -type f -name "bit*" ! -name "*.tar.gz" ! -name "*.sha256" | head -1)
            if [ -z "$BIT_BIN" ]; then
                die "Binary not found in archive"
            fi
            ;;
        *.exe)
            BIT_BIN="$BINARY_NAME"
            ;;
        *)
            BIT_BIN="$BINARY_NAME"
            ;;
    esac
    
    # Vérifier que le binaire existe
    if [ ! -f "$BIT_BIN" ]; then
        die "Binary not found"
    fi
    
    # Rendre exécutable
    chmod +x "$BIT_BIN"
    
    # Installer dans /usr/local/bin
    log_step "Installing to ${INSTALL_DIR}/bit"
    
    # Vérifier les permissions
    if [ -w "$INSTALL_DIR" ]; then
        cp "$BIT_BIN" "${INSTALL_DIR}/bit"
    else
        log_warn "Need sudo to install to ${INSTALL_DIR}"
        sudo cp "$BIT_BIN" "${INSTALL_DIR}/bit"
    fi
    
    # Nettoyer
    cd /
    rm -rf "$TMP_DIR"
    
    log_success "bit installed to ${INSTALL_DIR}/bit"
}

install_from_source() {
    log_step "Building from source (fallback)..."
    
    # Vérifier les dépendances
    for cmd in gcc make git; do
        if ! has_command "$cmd"; then
            die "Missing build dependency: $cmd"
        fi
    done
    
    # Vérifier curl-dev
    if [ "$PLATFORM" = "linux" ] && ! has_command curl-config; then
        log_error "Missing libcurl-dev"
        if has_command apk; then
            echo "  Run: sudo apk add curl-dev"
        elif has_command apt-get; then
            echo "  Run: sudo apt-get install libcurl4-openssl-dev"
        elif has_command yum; then
            echo "  Run: sudo yum install libcurl-devel"
        fi
        die "Build failed"
    fi
    
    # Cloner
    TMP_DIR="/tmp/bit-build.$$"
    git clone --depth=1 "https://github.com/${GITHUB_REPO}.git" "$TMP_DIR"
    cd "$TMP_DIR"
    
    # Compiler
    log_info "Compiling..."
    make release
    
    # Installer
    if [ -w "$INSTALL_DIR" ]; then
        cp bin/bit "${INSTALL_DIR}/bit"
    else
        sudo cp bin/bit "${INSTALL_DIR}/bit"
    fi
    
    # Nettoyer
    cd /
    rm -rf "$TMP_DIR"
    
    log_success "bit built and installed to ${INSTALL_DIR}/bit"
}

# =============================================================================
#                            MAIN
# =============================================================================

main() {
    # Banner
    cat << "EOF"
╔═══════════════════════════════════════╗
║  bitup - The Bitbucket CLI Installer  ║
║  github.com/gopu-inc/bit              ║
╚═══════════════════════════════════════╝
EOF
    echo ""

    # Détection plateforme
    detect_platform
    
    # Vérifier si déjà installé
    if [ -f "${INSTALL_DIR}/bit" ]; then
        log_warn "bit already exists in ${INSTALL_DIR}/bit"
        printf "Overwrite? [y/N] "
        read -r answer
        case "$answer" in
            y|Y|yes|YES) ;;
            *) die "Installation cancelled" ;;
        esac
    fi
    
    # Essayer installation binaire
    if ! install_binary 2>/dev/null; then
        log_warn "Binary download failed, falling back to source build"
        install_from_source
    fi
    
    # Vérification finale
    if command -v bit >/dev/null 2>&1; then
        log_success "bit installed successfully!"
        echo ""
        echo "Try it: bit --help"
    else
        log_warn "bit installed but not in PATH"
        echo "  Run: ${INSTALL_DIR}/bit --help"
    fi
}

# Exécution
main "$@"
