#!/bin/sh
# bitup - The Bitbucket CLI installer for gopu.inc
# Supports: x86_64, aarch64, i686 (x86)

set -eu

# Configuration
GITHUB_REPO="gopu-inc/bit"
GITHUB_API="https://api.github.com/repos/${GITHUB_REPO}/releases/downloads"
INSTALL_DIR="/usr/local/bin"

# Couleurs
G='\033[0;32m'; B='\033[1;34m'; R='\033[0;31m'; NC='\033[0m'

log_step() { printf "${B}==>${NC} 1.0.2 %s\n" "$*"; }
log_error() { printf "${R}error:${NC} %s\n" "$*" >&2; exit 1; }

# 1. Détection précise de l'architecture
ARCH=$(uname -m)
case "${ARCH}" in
    x86_64|amd64)   ASSET_KEY="x64" ;;    # Pour bit-linux_x64-v1.0.2.1.tar.gz
    aarch64|arm64)  ASSET_KEY="aarch64" ;; # Pour bit-1.0.2-aarch64.tar.gz
    i386|i686)      ASSET_KEY="x86" ;;     # Pour bit-linux_x86-v1.0.2.1.tar.gz
    *) log_error "Architecture ${ARCH} non supportée." ;;
esac

main() {
    log_step "Fetching release data for ${ARCH}..."
    
    # Récupération du JSON de la dernière release
    RELEASE_DATA=$(curl -s "$GITHUB_API")
    
    # 2. Extraction de l'URL de l'asset correspondant à l'architecture
    # On cherche le .tar.gz qui contient notre ASSET_KEY
    DOWNLOAD_URL=$(echo "$RELEASE_DATA" | grep "browser_download_url" | grep "$ASSET_KEY" | grep ".tar.gz" | head -1 | cut -d'"' -f4)

    if [ -z "$DOWNLOAD_URL" ]; then
        log_error "Aucun asset trouvé pour ${ASSET_KEY} sur GitHub."
    fi

    ASSET_NAME=$(basename "$DOWNLOAD_URL")
    TMP_DIR=$(mktemp -d)
    cd "$TMP_DIR"

    # 3. Téléchargement et Vérification SHA256 (si disponible)
    log_step "Downloading ${ASSET_NAME}..."
    curl -fL "$DOWNLOAD_URL" -o "package.tar.gz"

    # 4. Extraction et Installation
    tar -xzf "package.tar.gz"
    # On cherche le binaire 'bit' extrait
    BIT_BIN=$(find . -type f -name "bit*" ! -name "*.tar.gz" | head -1)
    
    chmod +x "$BIT_BIN"
    
    log_step "Moving binary to ${INSTALL_DIR}..."
    if [ -w "$INSTALL_DIR" ]; then
        mv "$BIT_BIN" "${INSTALL_DIR}/bit"
    else
        sudo mv "$BIT_BIN" "${INSTALL_DIR}/bit"
    fi

    rm -rf "$TMP_DIR"
    printf "${G}✅ Installation terminée avec succès !${NC}\n"
    bit --help
}

main "$@"
