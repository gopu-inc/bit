#!/bin/sh
# bitup - The Bitbucket CLI installer (Dynamic GitHub Release Loader)
# https://github.com/gopu-inc/bit
#
# Usage: curl -fsSL https://raw.githubusercontent.com/gopu-inc/bit/main/script/bitup-sh | sudo sh

set -eu

# =============================================================================
#                        CONFIGURATION & COLORS
# =============================================================================
GITHUB_REPO="gopu-inc/bit"
GITHUB_API="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"
INSTALL_DIR="/usr/local/bin"

if [ -t 1 ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
    G='\033[0;32m'; Y='\033[1;33m'; B='\033[1;34m'; R='\033[0;31m'; NC='\033[0m'; BOLD='\033[1m'
else
    G=''; Y=''; B=''; R=''; NC=''; BOLD=''
fi

log_info() { printf "${G}info:${NC} %s\n" "$*"; }
log_step() { printf "${B}==>${NC} ${BOLD}%s${NC}\n" "$*"; }
log_error() { printf "${R}error:${NC} %s\n" "$*" >&2; exit 1; }

# =============================================================================
#                            DETECTION
# =============================================================================
PLATFORM="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"

case "${ARCH}" in
    x86_64|amd64)   ASSET_ARCH="x86_64" ;;
    aarch64|arm64)  ASSET_ARCH="aarch64" ;;
    *)              log_error "Architecture ${ARCH} non supportée." ;;
esac

# =============================================================================
#                            INSTALLATION
# =============================================================================
main() {
    log_step "Fetching latest release from GitHub..."
    
    # Récupération des données de la dernière release
    RELEASE_DATA=$(curl -s "$GITHUB_API")
    LATEST_TAG=$(echo "$RELEASE_DATA" | grep -m1 '"tag_name":' | cut -d'"' -f4)
    
    if [ -z "$LATEST_TAG" ]; then
        log_error "Impossible de trouver la dernière version sur GitHub."
    fi
    
    log_info "Version détectée : ${LATEST_TAG}"

    # Filtrage de l'URL de l'asset (priorité aux .tar.gz comme sur ton image)
    DOWNLOAD_URL=$(echo "$RELEASE_DATA" | grep "browser_download_url" | grep "$ASSET_ARCH" | head -1 | cut -d'"' -f4)

    if [ -z "$DOWNLOAD_URL" ]; then
        log_error "Aucun binaire trouvé pour ${PLATFORM}-${ASSET_ARCH}."
    fi

    log_step "Downloading $(basename "$DOWNLOAD_URL")..."
    TMP_DIR=$(mktemp -d)
    cd "$TMP_DIR"
    curl -fL "$DOWNLOAD_URL" -o "bit_package"

    # Extraction ou renommage
    if echo "$DOWNLOAD_URL" | grep -q ".tar.gz"; then
        tar -xzf "bit_package"
        BIT_BIN=$(find . -type f -name "bit*" ! -name "*.tar.gz" | head -1)
    else
        BIT_BIN="bit_package"
    fi

    chmod +x "$BIT_BIN"

    # Installation finale
    log_step "Installing to ${INSTALL_DIR}/bit"
    if [ -w "$INSTALL_DIR" ]; then
        mv "$BIT_BIN" "${INSTALL_DIR}/bit"
    else
        sudo mv "$BIT_BIN" "${INSTALL_DIR}/bit"
    fi

    rm -rf "$TMP_DIR"
    printf "${G}✅ bit ${LATEST_TAG} est installé et prêt !${NC}\n"
    echo "Lancez 'bit login' pour commencer."
}

main "$@"
