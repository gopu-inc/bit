#!/bin/sh
# bitup - The Bitbucket CLI installer
# https://github.com/gopu-inc/bit
#
# Usage: curl -fsSL https://raw.githubusercontent.com/gopu-inc/bit/main/script/bitup-sh | sh
#        curl -fsSL https://raw.githubusercontent.com/gopu-inc/bit/main/script/bitup-sh | sh -s -- --help

set -eu

# =============================================================================
#                        BITUP PROFESSIONAL INSTALLER
# =============================================================================
# Version: 1.0.2
# Author: gopu-inc
# License: MIT
# =============================================================================

# Configuration
BITUP_VERSION="1.0.2"
GITHUB_REPO="gopu-inc/bit"
RELEASE_TAG="downloads"
RAW_BASE="https://raw.githubusercontent.com/${GITHUB_REPO}/main"
RELEASE_BASE="https://github.com/${GITHUB_REPO}/releases/download/${RELEASE_TAG}"
INSTALL_ROOT="${HOME}/.bitup"

# Colors
if [ -t 1 ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    MAGENTA='\033[0;35m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    DIM='\033[2m'
    NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; MAGENTA=''; CYAN=''; BOLD=''; DIM=''; NC=''
fi

# =============================================================================
#                            UTILITY FUNCTIONS
# =============================================================================

log_info() { printf "${GREEN}info:${NC} %s\n" "$*"; }
log_warn() { printf "${YELLOW}warning:${NC} %s\n" "$*" >&2; }
log_error() { printf "${RED}error:${NC} %s\n" "$*" >&2; }
log_step() { printf "${BLUE}==>${NC} ${BOLD}%s${NC}\n" "$*"; }
log_success() { printf "${GREEN}✅ %s${NC}\n" "$*"; }
log_debug() { if [ "${BITUP_DEBUG:-0}" = "1" ]; then printf "${DIM}[DEBUG] %s${NC}\n" "$*"; fi; }
die() { log_error "$*"; exit 1; }

has_command() { command -v "$1" >/dev/null 2>&1; }

detect_platform() {
    PLATFORM="$(uname -s | tr '[:upper:]' '[:lower:]')"
    ARCH="$(uname -m)"
    
    case "${PLATFORM}" in
        linux)      PLATFORM="linux" ;;
        darwin)     PLATFORM="darwin" ;;
        mingw*|cygwin*|msys*) PLATFORM="windows" ;;
        *)          die "Unsupported platform: ${PLATFORM}" ;;
    esac
    
    case "${ARCH}" in
        x86_64|amd64)   ARCH="x86_64" ;;
        aarch64|arm64)  ARCH="aarch64" ;;
        i*86)           ARCH="x86" ;;  # i686, i386 -> x86
        armv7l)         ARCH="armv7" ;;
        *)              die "Unsupported architecture: ${ARCH}" ;;
    esac
    
    # Special case for Apple Silicon
    if [ "${PLATFORM}" = "darwin" ] && [ "${ARCH}" = "aarch64" ]; then
        ARCH="arm64"
    fi
    
    log_debug "Detected platform: ${PLATFORM}-${ARCH}"
}

download() {
    url="$1"
    output="$2"
    
    if has_command curl; then
        if [ -t 1 ]; then
            curl -fSL --progress-bar "$url" -o "$output"
        else
            curl -fSL "$url" -o "$output"
        fi
    elif has_command wget; then
        if [ -t 1 ]; then
            wget -q --show-progress "$url" -O "$output"
        else
            wget -q "$url" -O "$output"
        fi
    else
        die "Neither curl nor wget found. Please install one of them."
    fi
}

download_raw() {
    path="$1"
    output="$2"
    download "${RAW_BASE}/${path}" "$output"
}

verify_checksum() {
    file="$1"
    expected_file="$2"
    
    if [ ! -f "$expected_file" ]; then
        log_warn "No checksum file found, skipping verification"
        return 0
    fi
    
    expected=$(cat "$expected_file" | cut -d' ' -f1)
    
    if has_command sha256sum; then
        actual=$(sha256sum "$file" | cut -d' ' -f1)
    elif has_command shasum; then
        actual=$(shasum -a 256 "$file" | cut -d' ' -f1)
    else
        log_warn "No checksum tool found, skipping verification"
        return 0
    fi
    
    if [ "$actual" != "$expected" ]; then
        log_error "Checksum mismatch"
        log_debug "Expected: $expected"
        log_debug "Actual:   $actual"
        return 1
    fi
    log_success "Checksum verified"
    return 0
}

# =============================================================================
#                        INSTALLATION
# =============================================================================

get_binary_name() {
    # Format: bit-<version>-<arch>.<ext>
    # D'après vos assets: 
    # - bit-1.0.2-aarch64.tar.gz
    # - bit-linux-x86_64
    # - bit-linux_x64-v1.0.2.1.tar.gz
    # - bit-linux_x86-v1.0.2.1.tar.gz
    
    version="${1:-1.0.2}"
    
    case "${PLATFORM}-${ARCH}" in
        linux-x86_64)
            # Chercher d'abord le binaire direct
            if curl -sI "${RELEASE_BASE}/bit-linux-x86_64" | head -n1 | grep -q 200; then
                echo "bit-linux-x86_64"
            else
                echo "bit-linux_x64-v${version}.tar.gz"
            fi
            ;;
        linux-x86)
            echo "bit-linux_x86-v${version}.tar.gz"
            ;;
        linux-aarch64)
            echo "bit-${version}-aarch64.tar.gz"
            ;;
        darwin-arm64)
            echo "bit-darwin-arm64"
            ;;
        darwin-x86_64)
            echo "bit-darwin-x86_64"
            ;;
        windows-x86_64)
            echo "bit-windows-x86_64.exe"
            ;;
        windows-x86)
            echo "bit-windows-x86.exe"
            ;;
        *)
            die "No binary available for ${PLATFORM}-${ARCH}"
            ;;
    esac
}

install_binary() {
    version="${1:-1.0.2}"
    
    log_step "Installing bit ${version} for ${PLATFORM}-${ARCH}"
    
    # Create directories
    mkdir -p "${INSTALL_ROOT}/bin"
    mkdir -p "${INSTALL_ROOT}/tmp"
    
    # Get binary name
    BINARY_NAME=$(get_binary_name "$version")
    BINARY_URL="${RELEASE_BASE}/${BINARY_NAME}"
    
    log_info "Downloading: ${BINARY_NAME}"
    
    # Download binary
    TMP_FILE="${INSTALL_ROOT}/tmp/${BINARY_NAME}"
    download "$BINARY_URL" "$TMP_FILE"
    
    # Download checksum if exists
    CHECKSUM_URL="${RELEASE_BASE}/${BINARY_NAME}.sha256"
    CHECKSUM_FILE="${INSTALL_ROOT}/tmp/${BINARY_NAME}.sha256"
    
    if curl -sI "$CHECKSUM_URL" | head -n1 | grep -q 200 2>/dev/null; then
        download "$CHECKSUM_URL" "$CHECKSUM_FILE"
    fi
    
    # Extract if it's a tar.gz
    FINAL_BINARY="${INSTALL_ROOT}/bin/bit"
    
    case "$BINARY_NAME" in
        *.tar.gz)
            log_info "Extracting archive..."
            tar_dir="${INSTALL_ROOT}/tmp/extract"
            mkdir -p "$tar_dir"
            tar -xzf "$TMP_FILE" -C "$tar_dir"
            # Find the binary in the extracted files
            find "$tar_dir" -type f -name "bit*" -exec cp {} "$FINAL_BINARY" \;
            rm -rf "$tar_dir"
            ;;
        *.exe)
            FINAL_BINARY="${INSTALL_ROOT}/bin/bit.exe"
            cp "$TMP_FILE" "$FINAL_BINARY"
            ;;
        *)
            cp "$TMP_FILE" "$FINAL_BINARY"
            ;;
    esac
    
    chmod +x "$FINAL_BINARY" 2>/dev/null || true
    
    # Verify checksum
    if [ -f "$CHECKSUM_FILE" ]; then
        verify_checksum "$FINAL_BINARY" "$CHECKSUM_FILE"
    fi
    
    # Cleanup
    rm -rf "${INSTALL_ROOT}/tmp"
    
    log_success "bit installed to ${FINAL_BINARY}"
}

install_from_source() {
    log_step "Building from source..."
    
